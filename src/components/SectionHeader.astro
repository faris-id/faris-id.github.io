---
interface Props {
  number: string;
  title: string;
  description?: string;
}

const { number, title, description } = Astro.props;
---

<div class="border-t border-line pt-5" data-reveal>
  <p class="eyebrow">{number}</p>
  <h2 class="mt-3 font-serif text-[2.625rem] font-medium leading-none tracking-tight text-ink md:text-[3.5rem]">
    {title}
  </h2>
  {description && (
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{description}</p>
  )}
</div>
