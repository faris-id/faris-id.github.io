---
interface Props {
  number: string;
  title: string;
  description?: string;
}

const { number, title, description } = Astro.props;
---

<div class="border-t border-line pt-5" data-reveal>
  <p class="eyebrow">{number}</p>
  <div class="mt-3 flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
    <h2 class="font-serif text-[2.625rem] font-medium leading-none tracking-tight text-ink md:text-[3.5rem]">
      {title}
    </h2>
    {description && <p class="max-w-sm text-sm leading-relaxed text-muted">{description}</p>}
  </div>
</div>
