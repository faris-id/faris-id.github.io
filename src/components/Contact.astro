---
import { profile, socials } from '../data/profile';
import CopyEmail from './CopyEmail';
import SectionHeader from './SectionHeader.astro';
import SocialIcon from './SocialIcon.astro';

const elsewhere = socials.filter((social) => social.icon !== 'mail');
---

<section id="contact" class="section">
  <div class="wrap">
    <SectionHeader
      number="06"
      title="Contact"
      description="Leadership roles, consulting work, and business inquiries are all welcome."
    />

    <div class="mt-10 grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7" data-reveal>
        <p class="font-serif text-[2.75rem] font-medium leading-[1.02] tracking-tight text-balance text-ink md:text-[4.25rem]">
          Happy here. <em class="text-accent">Still listening.</em>
        </p>
        <p class="mt-5 max-w-lg text-[0.9375rem] leading-relaxed text-muted">
          I'm not planning a move — I enjoy my work at NinjaOne. But if you're reaching out
          about a country manager or engineering director role in Indonesia, or a business idea
          worth a conversation, I'd be glad to hear it. Email is the quickest way to reach me, and
          I usually reply within a couple of days.
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3">
          <a href={`mailto:${profile.email}`} class="btn btn-primary">
            {profile.email}
            <span aria-hidden="true">→</span>
          </a>
          <CopyEmail email={profile.email} client:idle />
        </div>
      </div>

      <div class="md:col-span-4 md:col-start-9" data-reveal>
        <p class="eyebrow">Elsewhere</p>
        <ul class="mt-3 border-t border-line">
          {
            elsewhere.map((social) => (
              <li class="border-b border-line">
                <a
                  href={social.href}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="group flex items-center justify-between gap-4 py-3"
                >
                  <span class="flex items-center gap-2.5 text-sm text-ink">
                    <SocialIcon icon={social.icon} class="h-3.5 w-3.5 text-muted" />
                    {social.label}
                  </span>
                  <span class="text-xs text-muted">
                    {social.handle}
                    <span
                      class="ml-1 inline-block transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5"
                      aria-hidden="true"
                    >
                      ↗
                    </span>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
