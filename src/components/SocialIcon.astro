---
import {
  siFacebook,
  siGithub,
  siInstagram,
  siRss,
  siX,
  siYoutube,
} from 'simple-icons';
import type { SocialIcon as SocialIconName } from '../data/profile';

interface Props {
  icon: SocialIconName;
  class?: string;
}

const { icon, class: className = 'h-4 w-4' } = Astro.props;

// simple-icons no longer ships the LinkedIn mark, so keep the official path here.
const linkedInPath =
  'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z';

const brandIcons: Record<string, string> = {
  linkedin: linkedInPath,
  github: siGithub.path,
  x: siX.path,
  instagram: siInstagram.path,
  youtube: siYoutube.path,
  facebook: siFacebook.path,
  blog: siRss.path,
};

const path = brandIcons[icon];
---

{
  icon === 'mail' ? (
    <svg
      class={className}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <rect width="20" height="16" x="2" y="4" rx="2" />
      <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
    </svg>
  ) : (
    <svg class={className} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d={path} />
    </svg>
  )
}
