---
import { legacySkills, skillGroups } from '../data/skills';
import SectionHeader from './SectionHeader.astro';
---

<section id="skills" class="section">
  <div class="wrap">
    <SectionHeader
      number="04"
      title="Skills"
      description="The tools I reach for most, and the systems I like to work on."
    />

    <div class="mt-10 grid gap-x-10 gap-y-8 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
      {
        skillGroups.map((group) => (
          <div class="border-t border-line pt-4">
            <h3 class="eyebrow">{group.title}</h3>
            <ul class="mt-3 space-y-1 text-sm leading-relaxed text-ink">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <p
      class="mt-10 max-w-3xl border-t border-line pt-5 text-xs leading-relaxed text-muted"
      data-reveal
    >
      <span class="font-medium text-ink">Also worked with:</span>{' '}
      {legacySkills.join(' · ')}
    </p>
  </div>
</section>
