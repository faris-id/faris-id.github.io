---
import { certifications, education, honors } from '../data/education';
import SectionHeader from './SectionHeader.astro';
---

<section id="education" class="section">
  <div class="wrap">
    <SectionHeader
      number="05"
      title="Education"
      description="Formal training in informatics and business, plus a few certifications along the way."
    />

    <div class="mt-10 grid gap-12 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-7">
        <ol class="border-t border-line">
          {
            education.map((entry) => (
              <li class="border-b border-line py-5" data-reveal>
                <p class="text-[11px] uppercase tracking-[0.14em] text-muted tabular-nums">
                  {entry.period}
                </p>
                <h3 class="mt-2 text-base font-medium tracking-tight text-ink">
                  {entry.schoolUrl ? (
                    <a
                      class="link"
                      href={entry.schoolUrl}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {entry.school}
                    </a>
                  ) : (
                    entry.school
                  )}
                </h3>
                <p class="mt-1 text-sm leading-relaxed text-muted">{entry.degree}</p>
                {entry.note && <p class="mt-2 text-xs leading-relaxed text-muted">{entry.note}</p>}
              </li>
            ))
          }
        </ol>
      </div>

      <div class="md:col-span-5">
        <h3 class="eyebrow">Certifications</h3>
        <ul class="mt-3 border-t border-line" data-reveal>
          {
            certifications.map((certification) => (
              <li class="border-b border-line py-3">
                <p class="text-sm leading-snug text-ink">
                  {certification.href ? (
                    <a
                      class="link"
                      href={certification.href}
                      target="_blank"
                      rel="noreferrer noopener"
                    >
                      {certification.name}
                    </a>
                  ) : (
                    certification.name
                  )}
                </p>
                <p class="mt-0.5 text-xs text-muted">
                  {[certification.issuer, certification.date, certification.credential]
                    .filter(Boolean)
                    .join(' · ')}
                </p>
              </li>
            ))
          }
        </ul>

        <h3 class="eyebrow mt-8">Honors</h3>
        <ul class="mt-3 border-t border-line" data-reveal>
          {
            honors.map((honor) => (
              <li class="border-b border-line py-3">
                <p class="text-sm leading-snug text-ink">{honor.name}</p>
                <p class="mt-0.5 text-xs text-muted">
                  {[honor.issuer, honor.date].filter(Boolean).join(' · ')}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
